# Copy to scripts/msix.env (untracked) and fill in from Partner Center:
# Apps and games > LendSpare > Product management > Product identity.
MSIX_IDENTITY_NAME=""            # Package/Identity/Name, e.g. 12345Publisher.LendSpare
MSIX_PUBLISHER=""                # Package/Identity/Publisher, e.g. CN=1A2B3C4D-...
MSIX_PUBLISHER_DISPLAY_NAME=""   # Package/Properties/PublisherDisplayName
MSIX_DISPLAY_NAME="LendSpare"    # the reserved app name
