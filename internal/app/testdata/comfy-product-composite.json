{
  "1": {
    "class_type": "LoadImage",
    "inputs": { "image": "product.png" }
  },
  "2": {
    "class_type": "MeshProductMask",
    "inputs": { "image": ["1", 0] }
  },
  "3": {
    "class_type": "ImageScaleToTotalPixels",
    "inputs": { "image": ["1", 0], "upscale_method": "lanczos", "megapixels": 1.0, "resolution_steps": 1 }
  },
  "4": {
    "class_type": "VAEEncode",
    "inputs": { "pixels": ["3", 0], "vae": ["10", 2] }
  },
  "5": {
    "class_type": "RepeatLatentBatch",
    "inputs": { "samples": ["4", 0], "amount": 1 }
  },
  "6": {
    "class_type": "SetLatentNoiseMask",
    "inputs": { "samples": ["5", 0], "mask": ["2", 1] }
  },
  "7": {
    "class_type": "CLIPTextEncode",
    "inputs": { "clip": ["10", 1], "text": "the product standing on a clean studio table, soft daylight, professional product photography" }
  },
  "8": {
    "class_type": "CLIPTextEncode",
    "inputs": { "clip": ["10", 1], "text": "" }
  },
  "9": {
    "class_type": "KSampler",
    "inputs": {
      "seed": 42,
      "steps": 4,
      "cfg": 1,
      "sampler_name": "euler",
      "scheduler": "simple",
      "denoise": 1,
      "model": ["10", 0],
      "positive": ["7", 0],
      "negative": ["8", 0],
      "latent_image": ["6", 0]
    }
  },
  "10": {
    "class_type": "CheckpointLoaderSimple",
    "inputs": { "ckpt_name": "flux1-schnell-fp8.safetensors" }
  },
  "13": {
    "class_type": "VAEDecode",
    "inputs": { "samples": ["9", 0], "vae": ["10", 2] }
  },
  "14": {
    "class_type": "MeshProductComposite",
    "inputs": { "background": ["13", 0], "product": ["1", 0], "mask": ["2", 0], "shadow": 0.35 }
  },
  "15": {
    "class_type": "SaveImage",
    "inputs": { "filename_prefix": "mesh", "images": ["14", 0] }
  }
}
